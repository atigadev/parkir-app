# Hanya gambar yang boleh disajikan; jangan pernah mengeksekusi skrip di sini.
Options -Indexes -ExecCGI
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php5 .php7 .phar
<FilesMatch "\.(?i:php\d?|phtml|phar|html?|js|svg)$">
  Require all denied
</FilesMatch>
